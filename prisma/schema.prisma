generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum MeetingStatus {
  SCHEDULED
  ACTIVE
  ENDED
  EXPIRED
}

enum SurpriseState {
  CREATED
  WAITING_FOR_PARTICIPANTS
  READY
  VIDEO_PLAYING
  VIDEO_COMPLETED
  REVEALING
  REVEALED
  ENDED
}

enum ParticipantRole {
  ORGANIZER
  BIRTHDAY_GUEST
  GUEST
}

enum ParticipantVisibility {
  VISIBLE
  HIDDEN
}

enum ConnectionStatus {
  CONNECTING
  CONNECTED
  DISCONNECTED
}

model User {
  id           String @id @default(uuid()) @db.Uuid
  email        String @unique
  name         String
  passwordHash String?
  avatarUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  organizedMeetings Meeting[] @relation("MeetingOrganizer")
  participants MeetingParticipant[]
  sessions     Session[]
  createdInvitations MeetingInvitation[] @relation("InvitationCreator")
}

model Meeting {
  id                 String @id @default(uuid()) @db.Uuid
  title              String
  roomCode           String @unique
  organizerId        String @db.Uuid
  status             MeetingStatus @default(SCHEDULED)
  secretBirthdayMode Boolean @default(false)
  surpriseState      SurpriseState @default(CREATED)
  birthdayMessage    String?
  livekitRoomName    String @unique
  createdAt          DateTime @default(now())
  expiresAt          DateTime
  endedAt            DateTime?
  birthdayVideoStartedAt DateTime?
  revealedAt         DateTime?
  version            Int @default(0)
  organizer          User @relation("MeetingOrganizer", fields: [organizerId], references: [id], onDelete: Restrict)
  participants       MeetingParticipant[]
  invitations        MeetingInvitation[]
  birthdayMedia      BirthdayMedia?
  chatMessages       ChatMessage[]
  events             MeetingEvent[]
  @@index([organizerId, status])
  @@index([expiresAt, status])
}

model MeetingParticipant {
  id               String @id @default(uuid()) @db.Uuid
  meetingId        String @db.Uuid
  userId           String? @db.Uuid
  displayName      String
  role             ParticipantRole @default(GUEST)
  visibility       ParticipantVisibility @default(VISIBLE)
  connectionStatus ConnectionStatus @default(CONNECTING)
  cameraEnabled    Boolean @default(false)
  microphoneEnabled Boolean @default(false)
  screenSharing    Boolean @default(false)
  ready            Boolean @default(false)
  joinedAt         DateTime @default(now())
  leftAt           DateTime?
  meeting          Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user             User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  chatMessages     ChatMessage[]
  sessions         Session[]
  @@index([meetingId, visibility, connectionStatus])
  @@index([userId, meetingId])
}

model MeetingInvitation {
  id                String @id @default(uuid()) @db.Uuid
  meetingId         String @db.Uuid
  tokenHash         String @unique
  invitedEmail      String?
  role              ParticipantRole @default(GUEST)
  visibilityOnJoin  ParticipantVisibility @default(HIDDEN)
  createdBy         String @db.Uuid
  expiresAt         DateTime
  usedAt            DateTime?
  meeting           Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  creator           User @relation("InvitationCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  @@index([meetingId, expiresAt])
}

model Session {
  id            String @id @default(uuid()) @db.Uuid
  tokenHash     String @unique
  userId        String? @db.Uuid
  participantId String? @db.Uuid
  expiresAt     DateTime
  createdAt     DateTime @default(now())
  user          User? @relation(fields: [userId], references: [id], onDelete: Cascade)
  participant   MeetingParticipant? @relation(fields: [participantId], references: [id], onDelete: Cascade)
  @@index([userId, expiresAt])
  @@index([participantId, expiresAt])
  @@index([expiresAt])
}

model BirthdayMedia {
  id              String @id @default(uuid()) @db.Uuid
  meetingId       String @unique @db.Uuid
  uploadedBy      String @db.Uuid
  storageKey      String @unique
  fileName        String
  mimeType        String
  byteSize        BigInt
  durationSeconds Int?
  createdAt       DateTime @default(now())
  meeting         Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
}

model ChatMessage {
  id            String @id @default(uuid()) @db.Uuid
  meetingId     String @db.Uuid
  participantId String @db.Uuid
  body          String
  createdAt     DateTime @default(now())
  meeting       Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  participant   MeetingParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  @@index([meetingId, createdAt])
}

model MeetingEvent {
  id        String @id @default(uuid()) @db.Uuid
  meetingId String @db.Uuid
  actorId   String? @db.Uuid
  eventType String
  metadata  Json?
  createdAt DateTime @default(now())
  meeting   Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  @@index([meetingId, createdAt])
}
